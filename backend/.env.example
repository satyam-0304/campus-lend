# Server
PORT=3000

# Supabase — copy values from your Supabase project settings
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS — origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173

# HTTP-based Email APIs (Recommended for Render Free Tier - communicates via HTTPS port 443)
# Brevo (Sendinblue): Free 300 emails/day, sends to any @pec.edu.in address without requiring a custom domain
BREVO_API_KEY=xkeysib-your_brevo_api_key

# Resend: Free 100 emails/day (requires verified domain to send beyond account email)
RESEND_API_KEY=re_your_resend_api_key

# Gmail SMTP Email Verification Service (Local development or paid Render tiers with port 587 unblocked)
# Use your Gmail address and 16-character App Password (from Google Account > Security > 2-Step Verification > App passwords)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password
EMAIL_FROM="CampusLend" <no-reply@campuslend.pec.edu.in>

# Optional SMTP Host & Port overrides (defaults: smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
